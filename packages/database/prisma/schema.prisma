generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MessageMediaType {
  IMAGE
  FILE
  AUDIO
}

// ─── Core auth model — lean, only identity + auth fields ─────────────────────

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  emailVerified Boolean    @default(false)
  phone         String?    @unique
  passwordHash  String
  role          Role       @default(PATIENT)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile       UserProfile?
  doctorProfile DoctorProfile?
  refreshTokens RefreshToken[]
  participants  ConversationParticipant[]
  sentMessages  Message[]               @relation("SentMessages")

  @@index([email])
  @@index([role, status])
}

// ─── Separate profile so User stays thin ────────────────────────────────────

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  avatarUrl   String?   // Cloudinary URL
  dateOfBirth DateTime?
  gender      Gender?
  bio         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Refresh tokens stored in DB (access token blacklisted in Redis) ─────────

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 hash — never store raw token
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ─── Doctor profile — created after User registers as PATIENT ─────────────

model DoctorProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  String
  licenseNumber   String    @unique
  experienceYears Int
  bio             String?
  consultationFee Decimal?  @db.Decimal(10, 2)
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  verifiedBy      String?   // Admin userId who verified
  availableFrom   String?   // "09:00"
  availableTo     String?   // "17:00"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([specialization])
  @@index([isVerified])
}

// ─── Conversation — neutral container, participants via join table ────────────

model Conversation {
  id            String    @id @default(uuid())
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

// ─── Join table — many patients <-> many doctors ─────────────────────────────

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?    // used for unread count queries

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

// ─── Message ─────────────────────────────────────────────────────────────────

model Message {
  id             String            @id @default(uuid())
  conversationId String
  senderId       String
  content        String?           // nullable when sending media-only
  mediaUrl       String?           // Cloudinary URL
  mediaType      MessageMediaType?
  isDeleted      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}
